<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <dpiAwareness xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">PerMonitorV2</dpiAwareness>
      <!-- Opt in to long paths (>260 chars). Required so the scanner and
           ffmpeg-launch work on deeply nested series like
           D:\Medien\<Lange Serien-Namen>\Season XX\SXXEYY - <lange Episoden-Titel>.mkv
           that can easily cross the old MAX_PATH limit.
           Needs Windows 10 1607+; the HKLM registry flag is also honored if
           set system-wide, but this manifest setting activates it per-app
           without requiring user changes. -->
      <longPathAware xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">true</longPathAware>
    </windowsSettings>
  </application>
  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <!-- Windows 10 and Windows 11 -->
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}"/>
    </application>
  </compatibility>
</assembly>
